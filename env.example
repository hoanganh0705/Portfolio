GITHUB_TOKEN=
GITHUB_USERNAME=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_RATE_LIMIT=
CONTACT_RATE_WINDOW_MS=
CONTACT_MIN_REQUEST_INTERVAL_MS=

# --- Contact form rate limiter ---
# When UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN are set, the contact
# form uses Upstash Redis for distributed rate limiting. When unset, an
# in-memory limiter is used (suitable for dev and CI only — not production).
#
# Get these from https://console.upstash.com → Create Database → free tier.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Content Security Policy (CSP) ---
# CSP ships in Report-Only mode by default. Browsers log violations but
# nothing is blocked, so the site stays functional while you collect reports.
# After a week of low-violation reports, set CSP_ENFORCE=1 and rebuild to
# switch to enforced mode. Note: Next.js evaluates next.config.ts at build
# time, so the CSP_ENFORCE value is frozen when the build runs. Set it in
# Vercel project env, then redeploy (or push to main) to apply.
CSP_ENFORCE=
# Optional. If set, violations are POSTed to this URL as `application/csp-report`.
# Point it at any endpoint that accepts POST JSON (e.g. a Vercel route or
# an external report-collector service). Leave unset to skip report-uri.
CSP_REPORT_URI=