{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu",
        "skipAudits": [
          "uses-http2",
          "is-on-https"
        ]
      },
      "url": [
        "http://localhost:3000/en",
        "http://localhost:3000/en/work",
        "http://localhost:3000/en/work/portfolio-website",
        "http://localhost:3000/en/contact"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://localhost:3000/en",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median" }],
            "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/en/work",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3000, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median" }],
            "total-blocking-time": ["error", { "maxNumericValue": 300, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/en/work/portfolio-website",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3000, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median" }],
            "total-blocking-time": ["error", { "maxNumericValue": 300, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/en/contact",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median" }],
            "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median" }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
